<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://lojadefubecas.com/fubecas"
    xmlns:tns="http://lojadefubecas.com/fubecas"
    elementFormDefault="qualified">

    <!-- REQUISIÇÃO -->
    <xs:element name="consultarFubecaRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="codigo" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- RESPOSTA -->
    <xs:element name="consultarFubecaResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="nome" type="xs:string"/>
                <xs:element name="tipo" type="xs:string"/>
                <xs:element name="preco" type="xs:double"/>
                <xs:element name="quantidadeEstoque" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>